function getFreshBackupData(){return JSON.parse(JSON.stringify(db));}
function backupData(){try{save();const backup=getFreshBackupData(),backupFile={backupVersion:"2.0",backupType:"SPECIAL_STUDENTS_ATTENDANCE",createdAt:new Date().toISOString(),madrasaName:db.schoolName||activeMadrasa().name||"مدرسہ",schoolName:backup.schoolName||"",students:backup.students||[],attendance:backup.attendance||{}},json=JSON.stringify(backupFile,null,2),blob=new Blob([json],{type:"application/json;charset=utf-8"}),now=new Date(),date=now.toISOString().slice(0,10),time=now.toTimeString().slice(0,8).replace(/:/g,"-"),fileName=`Madrasa_Attendance_${date}_${time}.json`,url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download=fileName;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);try{localStorage.setItem(SELECTED_BACKUP_KEY,JSON.stringify({fileName,data:backupFile,savedAt:new Date().toISOString()}));selectedBackupFile={name:fileName,data:backupFile};document.getElementById("backupFileName").textContent="نیا بیک اپ تیار ہوگیا: "+fileName+" ✓";document.getElementById("restoreBtn").disabled=false;}catch(e){}alert("اس مدرسے کا بیک اپ تیار ہوگیا۔");}catch(error){alert("بیک اپ بنانے میں مسئلہ آیا: "+error.message);}}
let selectedBackupFile=null;
function validBackup(x){return !!(x&&Array.isArray(x.students)&&x.attendance&&typeof x.attendance==="object");}
function fileSelected(e){const file=e.target.files[0]||null;if(!file){e.target.value="";return;}const reader=new FileReader();reader.onload=()=>{try{const x=JSON.parse(reader.result);if(!validBackup(x))throw 0;localStorage.setItem(SELECTED_BACKUP_KEY,JSON.stringify({fileName:file.name,data:x,savedAt:new Date().toISOString()}));selectedBackupFile={name:file.name,data:x};document.getElementById("backupFileName").textContent="منتخب بیک اپ: "+file.name+" ✓";document.getElementById("restoreBtn").disabled=false;alert("بیک اپ منتخب ہوگیا۔ اب بحالی کا بٹن دبائیں۔");e.target.value="";}catch(error){alert("یہ درست حاضری بیک اپ فائل نہیں ہے۔");e.target.value="";}};reader.onerror=()=>{alert("بیک اپ فائل پڑھی نہیں جاسکی۔");e.target.value="";};reader.readAsText(file,"UTF-8");}
function restoreSelectedBackupInfo(){try{const raw=localStorage.getItem(SELECTED_BACKUP_KEY);if(!raw)throw 0;const saved=JSON.parse(raw);if(!validBackup(saved.data))throw 0;selectedBackupFile={name:saved.fileName||"منتخب بیک اپ",data:saved.data};document.getElementById("backupFileName").textContent="منتخب بیک اپ: "+selectedBackupFile.name+" ✓";document.getElementById("restoreBtn").disabled=false;}catch(e){localStorage.removeItem(SELECTED_BACKUP_KEY);selectedBackupFile=null;document.getElementById("backupFileName").textContent="کوئی بیک اپ فائل منتخب نہیں کی گئی۔";document.getElementById("restoreBtn").disabled=true;}}
function restoreSelected(){if(!selectedBackupFile){restoreSelectedBackupInfo();if(!selectedBackupFile)return alert("پہلے بیک اپ فائل منتخب کریں۔");}if(!confirm("منتخب بیک اپ موجودہ منتخب مدرسے کے طلبہ اور حاضری سے بدل جائے گا۔ کیا جاری رکھیں؟"))return;try{const x=selectedBackupFile.data;if(!validBackup(x))throw 0;db=cleanDB(x);if(!save())throw 0;init();alert("منتخب مدرسے کا بیک اپ بحال ہوگیا۔");}catch(error){alert("بیک اپ بحال نہیں ہوسکا۔");}}
function clearSelectedBackup(){if(!confirm("کیا منتخب بیک اپ کو اس ایپ سے ہٹانا ہے؟ اصل JSON فائل حذف نہیں ہوگی۔"))return;localStorage.removeItem(SELECTED_BACKUP_KEY);selectedBackupFile=null;document.getElementById("backupFileName").textContent="کوئی بیک اپ فائل منتخب نہیں کی گئی۔";document.getElementById("restoreBtn").disabled=true;}

</script>
