<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مکاتب حاضری مینجمنٹ</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f1f5f9;color:#172033;font-family:Arial,"Noto Nastaliq Urdu",sans-serif}
header{background:#0f766e;color:#fff;padding:16px;text-align:center;position:sticky;top:0;z-index:5}
header h1{margin:0 0 8px;font-size:24px}#schoolTitle{font-size:19px;font-weight:bold}
.container{max-width:1100px;margin:auto;padding:14px}.card{background:#fff;border-radius:14px;padding:16px;margin-bottom:14px;box-shadow:0 2px 10px #00000012}
h2{margin:0 0 12px;font-size:20px;color:#0f766e}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
input,select,button{width:100%;padding:11px;border-radius:9px;border:1px solid #cbd5e1;font-size:15px}
button{border:0;background:#0f766e;color:#fff;cursor:pointer;font-weight:bold}.btn-red{background:#dc2626}.btn-blue{background:#2563eb}.btn-gray{background:#475569}.btn-green{background:#16a34a}.btn-orange{background:#ea580c}
.actions{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px}.notice{padding:10px;background:#ecfeff;border-right:4px solid #0f766e;border-radius:8px;margin-bottom:10px}
.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:500px}th,td{padding:10px;border-bottom:1px solid #e2e8f0;text-align:center}th{background:#f8fafc}
.present{background:#dcfce7!important;color:#166534;font-weight:bold}.absent{background:#fee2e2!important;color:#991b1b;font-weight:bold}.status-btn{min-width:100px;border-radius:20px}
.student-row{display:flex;align-items:center;gap:10px;justify-content:space-between;border:1px solid #e2e8f0;border-radius:10px;padding:8px;margin:7px 0}
.student-name{font-weight:bold;flex:1;text-align:right}.small{font-size:12px;color:#64748b}.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:9px}
.stat{padding:14px;border-radius:12px;background:#f8fafc;text-align:center}.attendance-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:10px 0}.summary-btn{padding:12px;border-radius:10px;border:1px solid #cbd5e1;font-weight:bold;cursor:pointer}.summary-total{background:#fff;color:#172033}.summary-present{background:#16a34a;color:#fff;border-color:#16a34a}.summary-absent{background:#dc2626;color:#fff;border-color:#dc2626}.summary-btn b{font-size:20px;display:block;margin-top:3px}.stat b{display:block;font-size:22px;margin-top:4px}.report-title{text-align:center;margin-bottom:15px}
footer{text-align:center;color:#64748b;padding:20px}
@media print{header,.no-print,.card.form-card{display:none!important}body{background:#fff}.card{box-shadow:none;border:0}#reportArea{display:block!important}}

.home-page{min-height:100vh;background:linear-gradient(145deg,#e0f2fe,#f0fdfa);display:flex;align-items:center;justify-content:center;padding:24px}
.home-inner{width:100%;max-width:520px;text-align:center}
.home-inner h1{color:#134e4a;font-size:28px;margin:0 0 10px}
.home-inner p{color:#475569;margin:0 0 28px}
.folder-card{width:min(100%,330px);margin:auto;background:#fff;border:1px solid #cbd5e1;border-radius:20px;padding:25px 18px;box-shadow:0 8px 24px #0f172a18;cursor:pointer;color:#134e4a;transition:transform .15s,box-shadow .15s}
.folder-card:active{transform:scale(.98)}
.folder-icon{font-size:76px;line-height:1.2;display:block;margin-bottom:12px}
.folder-card strong{font-size:23px;display:block}
.folder-card small{display:block;color:#64748b;margin-top:8px;font-size:14px}
.home-footer{margin-top:28px;color:#64748b;font-size:13px}
#appRoot{display:none}
.home-back{width:auto;padding:7px 13px;margin-top:10px;background:#115e59;border:1px solid #ffffff66;font-size:14px}
@media(max-width:480px){.home-inner h1{font-size:24px}.folder-card{padding:22px 14px}}

#loginGate{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;background:linear-gradient(145deg,#e0f2fe,#f0fdfa)}
.login-card{width:100%;max-width:420px;background:#fff;border-radius:18px;padding:24px;box-shadow:0 8px 28px #0f172a20;text-align:center}
.login-card h2{margin-bottom:10px}.login-card input{margin:7px 0;direction:ltr;text-align:left}
#loginMessage{min-height:24px;color:#b91c1c;font-size:14px;margin-top:8px}
#cloudStatus{font-size:12px;background:#ecfeff;color:#155e75;padding:6px 10px;border-radius:20px;display:inline-block;margin-top:7px}
#logoutBtn{width:auto;padding:7px 12px;background:#475569;margin:8px auto 0}
</style>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
</head>
<body>
<div id="loginGate">
  <div class="login-card">
    <h2>🔐 مکاتب حاضری مینجمنٹ</h2>
    <p>مجاز صارف اپنا ای میل اور پاس ورڈ درج کرکے لاگ اِن کریں۔</p>
    <form onsubmit="event.preventDefault();loginUser()">
      <input id="loginEmail" type="email" autocomplete="username" placeholder="Email address" required>
      <input id="loginPassword" type="password" autocomplete="current-password" placeholder="Password" required>
      <button type="submit" id="loginBtn">لاگ اِن کریں</button>
    </form>
    <div id="loginMessage"></div>
    <div class="small">اکاؤنٹ منتظم کی طرف سے بنایا جائے گا۔</div>
  </div>
</div>
<div id="homePage" class="home-page">
  <div class="home-inner">
    <h1>مکاتب حاضری مینجمنٹ</h1>
    <p>تمام مکاتب کے طلبہ اور حاضری کا مکمل نظام</p>
    <div class="folder-card" role="button" tabindex="0" onclick="openAttendanceSystem()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openAttendanceSystem()}">
      <span class="folder-icon">📁</span>
      <strong>مکاتب حاضری مینجمنٹ</strong>
      <small>سسٹم کھولنے کے لیے یہاں کلک کریں</small>
    </div>
    <div class="home-footer">حاضری، طلبہ، ماہانہ و سالانہ رپورٹس اور بیک اپ</div>
  </div>
</div>
<div id="appRoot">
<header><h1>مکاتب حاضری مینجمنٹ</h1><div id="schoolTitle">مدرسہ کا نام درج کریں</div><div><span id="cloudStatus">آن لائن ڈیٹا بیس</span></div><button id="logoutBtn" class="no-print" onclick="logoutUser()">لاگ آؤٹ</button><button class="home-back no-print" onclick="backToHome()">⌂ مرکزی صفحہ</button></header>
<div class="container">
<div class="card form-card"><h2>🏫 مدرسہ / مکتب منتخب کریں</h2><div class="grid"><select id="madrasaSelect" onchange="switchMadrasa(this.value)" aria-label="مدرسہ منتخب کریں"></select><button class="btn-green" onclick="addMadrasa()">➕ نیا مدرسہ / مکتب شامل کریں</button><button class="btn-red" onclick="deleteMadrasa()">🗑️ موجودہ مدرسہ حذف کریں</button></div><div class="small">ہر مدرسے کے طلبہ، حاضری، ماہانہ و سالانہ رپورٹس اور بیک اپ الگ محفوظ رہیں گے۔</div></div>
<div class="card form-card"><h2>🏫 مدرسہ کی معلومات</h2><div class="grid"><input id="schoolName" placeholder="مدرسہ کا نام لکھیں"><button onclick="saveSchoolName()">مدرسہ کا نام محفوظ کریں</button></div><div class="small">مدرسہ کا نام ایک مرتبہ محفوظ کرنے کے بعد تمام رپورٹس میں خودکار ظاہر ہوگا۔</div></div>
<div class="card form-card"><h2>👨‍🎓 طالب علم شامل کریں</h2><div class="grid"><input id="studentName" placeholder="طالب علم کا نام"><input id="rollNo" placeholder="رول نمبر (اختیاری)"><button onclick="addStudent()">طالب علم شامل کریں</button></div></div>
<div class="card form-card"><h2>📅 روزانہ حاضری</h2><div class="grid"><input type="date" id="attendanceDate" lang="en-GB" title="تاریخ: D/m/y" onchange="loadAttendance()"><button onclick="loadAttendance()">حاضری لسٹ دکھائیں</button></div><div class="attendance-summary">
<button type="button" class="summary-btn summary-total" onclick="filterAttendance('all')">کل طلبہ<b id="totalStudentsCount">0</b></button>
<button type="button" class="summary-btn summary-present" onclick="filterAttendance('present')">حاضر طلبہ<b id="presentStudentsCount">0</b></button>
<button type="button" class="summary-btn summary-absent" onclick="filterAttendance('absent')">غیر حاضر طلبہ<b id="absentStudentsCount">0</b></button>
</div><div class="notice">📅 تاریخ کا کیلنڈر: D/m/y (دن/مہینہ/سال) &nbsp;&nbsp; 🟢 سبز = حاضر &nbsp;&nbsp; 🔴 لال = غیر حاضر</div><div id="attendanceList"></div></div>
<div class="card form-card"><h2>🔎 طالب علم کی رپورٹ</h2><div class="grid"><input id="searchStudent" list="studentNames" placeholder="طالب علم کا نام تلاش کریں" oninput="searchReport()"><datalist id="studentNames"></datalist><select id="reportMonth" onchange="searchReport()"></select><select id="reportYear" onchange="searchReport()"></select></div><div id="studentReport"></div></div>
<div class="card form-card"><h2>📊 تمام طلبہ کی رپورٹس اور بیک اپ</h2><div class="actions">
<button class="btn-blue" onclick="showMonthlyAll()">ماہانہ رپورٹ</button><button class="btn-orange" onclick="showYearlyAll()">سالانہ رپورٹ</button><button class="btn-gray" onclick="saveAsPDF()">📄 Save as PDF</button>
<button class="btn-green" onclick="backupData()">💾 بیک اپ محفوظ کریں</button><button class="btn-blue" onclick="document.getElementById('restoreFile').click()">📂 بیک اپ فائل منتخب کریں</button>
<button class="btn-gray" id="restoreBtn" onclick="restoreSelected()" disabled>♻️ منتخب بیک اپ بحال کریں</button><button class="btn-red" onclick="clearSelectedBackup()">🗑️ منتخب بیک اپ ہٹائیں</button>
<input id="restoreFile" type="file" accept=".json,application/json" hidden onchange="fileSelected(event)"><div id="backupFileName" class="small" style="grid-column:1/-1">کوئی بیک اپ فائل منتخب نہیں کی گئی۔</div>
</div></div>
<div class="card"><div id="reportArea"><div class="report-title"><h2 id="reportSchoolName"></h2><h2 id="reportHeading">رپورٹ</h2></div><div id="allReport"></div></div></div>
<div class="card form-card"><h2>👥 طلبہ کی فہرست</h2><div id="studentsList"></div></div>
</div>
<footer>مکاتب حاضری مینجمنٹ — ڈیٹا Firebase کے ذریعے مجاز موبائلز میں مشترک محفوظ ہوتا ہے۔</footer>
</div>
<script>
function openAttendanceSystem(){document.getElementById("homePage").style.display="none";document.getElementById("appRoot").style.display="block";window.scrollTo(0,0)}
function backToHome(){document.getElementById("appRoot").style.display="none";document.getElementById("homePage").style.display="flex";window.scrollTo(0,0)}

const firebaseConfig = {
  apiKey: "AIzaSyBTckc7sbcLjeZEkigqgPM84O5C18Q1Wdg",
  authDomain: "school-management-system-bcc11.firebaseapp.com",
  databaseURL: "https://school-management-system-bcc11-default-rtdb.firebaseio.com",
  projectId: "school-management-system-bcc11",
  storageBucket: "school-management-system-bcc11.firebasestorage.app",
  messagingSenderId: "810971362601",
  appId: "1:810971362601:web:2c85f396f9ecd6ce9ef338",
  measurementId: "G-TYRSNVNJME"
};
firebase.initializeApp(firebaseConfig);
const auth=firebase.auth(), cloudDB=firebase.database(), cloudRef=cloudDB.ref("makatibAttendance/appState");
let firebaseUser=null, cloudListener=null, cloudReady=false;
function setCloudStatus(message){const el=document.getElementById("cloudStatus");if(el)el.textContent=message;}
function showLoginMessage(message){const el=document.getElementById("loginMessage");if(el)el.textContent=message||"";}
async function loginUser(){
  const email=document.getElementById("loginEmail").value.trim(), password=document.getElementById("loginPassword").value;
  if(!email||!password)return;
  const btn=document.getElementById("loginBtn");btn.disabled=true;btn.textContent="لاگ اِن ہو رہا ہے...";showLoginMessage("");
  try{await auth.signInWithEmailAndPassword(email,password);}
  catch(e){showLoginMessage(firebaseAuthError(e));btn.disabled=false;btn.textContent="لاگ اِن کریں";}
}
function firebaseAuthError(e){const c=e&&e.code||"";if(c.includes("wrong-password")||c.includes("invalid-credential"))return"ای میل یا پاس ورڈ درست نہیں۔";if(c.includes("user-not-found"))return"یہ ای میل رجسٹرڈ نہیں۔ منتظم سے اکاؤنٹ بنوائیں۔";if(c.includes("invalid-email"))return"ای میل درست درج کریں۔";if(c.includes("too-many-requests"))return"بار بار کوشش ہوئی ہے۔ کچھ دیر بعد دوبارہ کوشش کریں۔";return"لاگ اِن نہیں ہوسکا: "+(e.message||c);}
async function logoutUser(){if(!confirm("کیا آپ لاگ آؤٹ کرنا چاہتے ہیں؟"))return;try{await auth.signOut();}catch(e){alert("لاگ آؤٹ میں مسئلہ: "+e.message)}}
async function startCloudSession(user){
  firebaseUser=user;cloudReady=false;document.getElementById("loginGate").style.display="none";document.getElementById("homePage").style.display="none";document.getElementById("appRoot").style.display="block";setCloudStatus("ڈیٹا لوڈ ہو رہا ہے...");
  try{
    const snap=await cloudRef.once("value");
    if(snap.exists()){
      const remote=snap.val();
      if(remote&&Array.isArray(remote.madrasas)&&remote.madrasas.length){appState=remote; if(!appState.madrasas.some(m=>m.id===appState.activeId))appState.activeId=appState.madrasas[0].id;appState.madrasas=appState.madrasas.map(m=>({id:String(m.id),name:m.name||m.data?.schoolName||"مدرسہ",data:cleanDB(m.data)}));db=activeMadrasa().data;localStorage.setItem(MULTI_KEY,JSON.stringify(appState));}
    } else {
      // پہلی مرتبہ: اس آلے کا موجودہ مقامی ریکارڈ کلاؤڈ میں منتقل کریں
      await cloudRef.set(appState);
    }
    cloudReady=true;init();setCloudStatus("☁️ مشترک ڈیٹا سے منسلک");
    if(cloudListener)cloudRef.off("value",cloudListener);
    cloudListener=snap=>{if(!cloudReady||!snap.exists())return;const incoming=snap.val();if(!incoming||!Array.isArray(incoming.madrasas))return;const a=JSON.stringify(incoming),b=JSON.stringify(appState);if(a!==b){appState=incoming;if(!appState.madrasas.some(m=>m.id===appState.activeId))appState.activeId=appState.madrasas[0].id;appState.madrasas=appState.madrasas.map(m=>({id:String(m.id),name:m.name||m.data?.schoolName||"مدرسہ",data:cleanDB(m.data)}));db=activeMadrasa().data;try{localStorage.setItem(MULTI_KEY,JSON.stringify(appState));}catch(e){}init();setCloudStatus("☁️ دوسرے موبائل سے نیا ڈیٹا موصول ہوا");}};
    cloudRef.on("value",cloudListener);
  }catch(e){setCloudStatus("کنکشن میں مسئلہ");alert("Firebase سے ڈیٹا حاصل نہیں ہوسکا۔ انٹرنیٹ اور Database Rules چیک کریں۔\n"+e.message);}
}
auth.onAuthStateChanged(user=>{if(user){startCloudSession(user);}else{firebaseUser=null;cloudReady=false;if(cloudListener){cloudRef.off("value",cloudListener);cloudListener=null;}document.getElementById("appRoot").style.display="none";document.getElementById("homePage").style.display="none";document.getElementById("loginGate").style.display="flex";const btn=document.getElementById("loginBtn");if(btn){btn.disabled=false;btn.textContent="لاگ اِن کریں";}}});

const KEY="SPECIAL_STUDENTS_ATTENDANCE_V1",MULTI_KEY="SPECIAL_STUDENTS_MULTI_MADRASA_V1",SELECTED_BACKUP_KEY="SPECIAL_STUDENTS_SELECTED_BACKUP_V1";
function emptyDB(name=""){return{schoolName:name,students:[],attendance:{}}}
function cleanDB(d){if(!d||typeof d!=="object")d=emptyDB();if(!Array.isArray(d.students))d.students=[];if(!d.attendance||typeof d.attendance!=="object")d.attendance={};return{schoolName:d.schoolName||"",students:d.students,attendance:d.attendance}}
function loadAppState(){
 try{const raw=localStorage.getItem(MULTI_KEY);if(raw){const st=JSON.parse(raw);if(st&&Array.isArray(st.madrasas)&&st.madrasas.length){st.madrasas=st.madrasas.map(m=>({id:String(m.id||("m_"+Date.now()+Math.random())),name:m.name||m.data?.schoolName||"مدرسہ",data:cleanDB(m.data)}));if(!st.madrasas.some(m=>m.id===st.activeId))st.activeId=st.madrasas[0].id;return st;}}}catch(e){}
 // پہلی بار پرانے ایک مدرسے کے ڈیٹا کو خودکار طور پر منتقل کریں
 let legacy=emptyDB();try{const raw=localStorage.getItem(KEY);if(raw)legacy=cleanDB(JSON.parse(raw));}catch(e){}
 const first={id:"m_"+Date.now(),name:legacy.schoolName||"پہلا مدرسہ",data:legacy};const st={madrasas:[first],activeId:first.id};try{localStorage.setItem(MULTI_KEY,JSON.stringify(st));}catch(e){}return st;
}
let appState=loadAppState();
function activeMadrasa(){return appState.madrasas.find(m=>m.id===appState.activeId)||appState.madrasas[0];}
let db=activeMadrasa().data;
function save(){try{const m=activeMadrasa();if(!m)return false;m.data=db;m.name=db.schoolName||m.name||"مدرسہ";localStorage.setItem(MULTI_KEY,JSON.stringify(appState));if(firebaseUser&&cloudReady){setCloudStatus("☁️ محفوظ کیا جا رہا ہے...");cloudRef.set(appState).then(()=>setCloudStatus("☁️ کلاؤڈ میں محفوظ ہوگیا")).catch(e=>{setCloudStatus("کلاؤڈ محفوظ نہیں ہوا");alert("مقامی ڈیوائس پر محفوظ ہوگیا، لیکن Firebase پر محفوظ نہیں ہوسکا: "+e.message);});}return true;}catch(e){alert("ڈیٹا محفوظ نہیں ہوسکا۔");return false}}
function renderMadrasaSelect(){const el=document.getElementById("madrasaSelect");if(!el)return;el.innerHTML=appState.madrasas.map(m=>`<option value="${esc(m.id)}">${esc(m.name)}</option>`).join("");el.value=appState.activeId;}
function switchMadrasa(id){if(id===appState.activeId)return;save();const m=appState.madrasas.find(x=>x.id===id);if(!m)return;appState.activeId=id;db=m.data;save();init();}
function addMadrasa(){const name=prompt("نئے مدرسے یا مکتب کا نام لکھیں:");if(name===null)return;const n=name.trim();if(!n)return alert("مدرسے کا نام ضروری ہے۔");if(appState.madrasas.some(m=>(m.name||"").trim().toLocaleLowerCase()===n.toLocaleLowerCase()))return alert("اس نام کا مدرسہ پہلے سے موجود ہے۔");save();const m={id:"m_"+Date.now()+"_"+Math.random().toString(36).slice(2,7),name:n,data:emptyDB(n)};appState.madrasas.push(m);appState.activeId=m.id;db=m.data;save();init();alert("نیا مدرسہ شامل ہوگیا۔");}
function deleteMadrasa(){if(appState.madrasas.length<=1)return alert("کم از کم ایک مدرسہ باقی رہنا ضروری ہے۔");const m=activeMadrasa();if(!confirm(`کیا ”${m.name}“ کو اس کے تمام طلبہ اور حاضری سمیت حذف کرنا چاہتے ہیں؟ یہ عمل واپس نہیں ہوگا۔`))return;appState.madrasas=appState.madrasas.filter(x=>x.id!==m.id);appState.activeId=appState.madrasas[0].id;db=activeMadrasa().data;save();init();alert("مدرسہ حذف ہوگیا۔");}
function today(){return new Date().toISOString().slice(0,10)}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function init(){renderMadrasaSelect();document.getElementById("attendanceDate").value=today();document.getElementById("schoolName").value=db.schoolName||"";document.getElementById("schoolTitle").textContent=db.schoolName||"مدرسہ کا نام درج کریں";document.getElementById("reportSchoolName").textContent=db.schoolName||"مدرسہ کا نام";let m=document.getElementById("reportMonth"),y=document.getElementById("reportYear");m.innerHTML="";for(let i=1;i<=12;i++)m.innerHTML+=`<option value="${i}">${monthName(i)}</option>`;let yr=new Date().getFullYear();y.innerHTML="";for(let i=yr-5;i<=yr+2;i++)y.innerHTML+=`<option value="${i}">${i}</option>`;m.value=new Date().getMonth()+1;y.value=yr;renderStudents();updateNames();loadAttendance();restoreSelectedBackupInfo()}
function monthName(m){return["","جنوری","فروری","مارچ","اپریل","مئی","جون","جولائی","اگست","ستمبر","اکتوبر","نومبر","دسمبر"][m]}
function saveSchoolName(){db.schoolName=document.getElementById("schoolName").value.trim()||"مدرسہ کا نام";if(save()){document.getElementById("schoolTitle").textContent=db.schoolName;document.getElementById("reportSchoolName").textContent=db.schoolName;renderMadrasaSelect();alert("مدرسہ کا نام محفوظ ہوگیا۔")}}
function addStudent(){let name=document.getElementById("studentName").value.trim(),roll=document.getElementById("rollNo").value.trim();if(!name)return alert("طالب علم کا نام لکھیں۔");db.students.push({id:Date.now().toString(),name,roll});if(save()){document.getElementById("studentName").value="";document.getElementById("rollNo").value="";renderStudents();updateNames();loadAttendance()}}
function deleteStudent(id){if(!confirm("کیا یہ طالب علم حذف کرنا ہے؟"))return;db.students=db.students.filter(s=>s.id!==id);for(const d in db.attendance)if(db.attendance[d])delete db.attendance[d][id];save();renderStudents();updateNames();loadAttendance()}
function editStudent(id){let s=db.students.find(x=>x.id===id);if(!s)return;let n=prompt("طالب علم کا نام:",s.name);if(n===null)return;n=n.trim();if(!n)return;s.name=n;save();renderStudents();updateNames();loadAttendance()}
function renderStudents(){let box=document.getElementById("studentsList");if(!db.students.length){box.innerHTML="<div class='notice'>ابھی کوئی طالب علم شامل نہیں کیا گیا۔</div>";return}box.innerHTML=db.students.map(s=>`<div class="student-row"><div class="student-name">${esc(s.name)} <span class="small">${s.roll?`(رول نمبر: ${esc(s.roll)})`:""}</span></div><button class="btn-blue" style="width:auto" onclick="editStudent('${s.id}')">ترمیم</button><button class="btn-red" style="width:auto" onclick="deleteStudent('${s.id}')">حذف</button></div>`).join("")}
function updateNames(){document.getElementById("studentNames").innerHTML=db.students.map(s=>`<option value="${esc(s.name)}">`).join("")}
let attendanceFilter="all";
function loadAttendance(){
  let date=document.getElementById("attendanceDate").value||today(),
      dayRecord=db.attendance[date]||{},
      box=document.getElementById("attendanceList");
  const total=db.students.length;
  const present=db.students.filter(s=>dayRecord[s.id]==="present").length;
  const absent=db.students.filter(s=>dayRecord[s.id]==="absent").length;
  document.getElementById("totalStudentsCount").textContent=total;
  document.getElementById("presentStudentsCount").textContent=present;
  document.getElementById("absentStudentsCount").textContent=absent;
  if(!total){box.innerHTML="<div class='notice'>پہلے طالب علم شامل کریں۔</div>";return}
  let students=db.students.filter(s=>{
    const v=dayRecord[s.id];
    return attendanceFilter==="all" || v===attendanceFilter;
  });
  if(!students.length){box.innerHTML="<div class='notice'>اس زمرے میں کوئی طالب علم نہیں ہے۔</div>";return}
  box.innerHTML=students.map(s=>{
    let v=dayRecord[s.id];
    return `<div class="student-row"><div class="student-name">${esc(s.name)} <span class="small">${s.roll?`رول: ${esc(s.roll)}`:""}</span></div><button class="status-btn ${v==="present"?"present":""}" onclick="setAttendance('${date}','${s.id}','present')">🟢 حاضر</button><button class="status-btn ${v==="absent"?"absent":""}" onclick="setAttendance('${date}','${s.id}','absent')">🔴 غیر حاضر</button></div>`;
  }).join("");
}
function filterAttendance(filter){attendanceFilter=filter;loadAttendance()}
function setAttendance(date,id,status){if(!db.attendance[date])db.attendance[date]={};db.attendance[date][id]=status;if(save()){loadAttendance();searchReport()}}
function getStats(id,from,to){let total=0,present=0,absent=0;for(const d in db.attendance)if(d>=from&&d<=to&&db.attendance[d]&&db.attendance[d][id]){total++;if(db.attendance[d][id]==="present")present++;else if(db.attendance[d][id]==="absent")absent++}return{total,present,absent,pct:total?((present/total)*100).toFixed(2):"0.00"}}
function searchReport(){let name=document.getElementById("searchStudent").value.trim(),box=document.getElementById("studentReport");if(!name){box.innerHTML="";return}let s=db.students.find(x=>x.name===name)||db.students.find(x=>x.name.includes(name));if(!s){box.innerHTML="<div class='notice'>طالب علم نہیں ملا۔</div>";return}let month=+document.getElementById("reportMonth").value,year=+document.getElementById("reportYear").value,from=`${year}-${String(month).padStart(2,"0")}-01`,last=new Date(year,month,0).getDate(),to=`${year}-${String(month).padStart(2,"0")}-${last}`,st=getStats(s.id,from,to),ys=getStats(s.id,`${year}-01-01`,`${year}-12-31`);box.innerHTML=`<div class="stat-grid"><div class="stat">طالب علم<b>${esc(s.name)}</b></div><div class="stat">ماہانہ حاضر<b>${st.present}</b></div><div class="stat">ماہانہ غیر حاضر<b>${st.absent}</b></div><div class="stat">ماہانہ فیصد<b>${st.pct}%</b></div><div class="stat">سالانہ حاضر<b>${ys.present}</b></div><div class="stat">سالانہ غیر حاضر<b>${ys.absent}</b></div><div class="stat">سالانہ فیصد<b>${ys.pct}%</b></div></div>`}
function showMonthlyAll(){let month=+document.getElementById("reportMonth").value,year=+document.getElementById("reportYear").value,last=new Date(year,month,0).getDate(),from=`${year}-${String(month).padStart(2,"0")}-01`,to=`${year}-${String(month).padStart(2,"0")}-${last}`;document.getElementById("reportHeading").textContent=`${monthName(month)} ${year} — ماہانہ حاضری رپورٹ`;document.getElementById("reportSchoolName").textContent=db.schoolName||"مدرسہ کا نام";document.getElementById("allReport").innerHTML=reportTable(from,to)}
function showYearlyAll(){let year=+document.getElementById("reportYear").value;document.getElementById("reportHeading").textContent=`${year} — سالانہ حاضری رپورٹ`;document.getElementById("reportSchoolName").textContent=db.schoolName||"مدرسہ کا نام";document.getElementById("allReport").innerHTML=reportTable(`${year}-01-01`,`${year}-12-31`)}
function reportTable(from,to){if(!db.students.length)return"<div class='notice'>کوئی طالب علم موجود نہیں۔</div>";return`<div class="table-wrap"><table><thead><tr><th>نمبر</th><th>طالب علم</th><th>رول نمبر</th><th>کل درج شدہ دن</th><th>حاضر</th><th>غیر حاضر</th><th>فیصد</th></tr></thead><tbody>${db.students.map((s,i)=>{let x=getStats(s.id,from,to);return`<tr><td>${i+1}</td><td>${esc(s.name)}</td><td>${esc(s.roll||"-")}</td><td>${x.total}</td><td class="present">${x.present}</td><td class="absent">${x.absent}</td><td>${x.pct}%</td></tr>`}).join("")}</tbody></table></div>`}
function saveAsPDF(){
  const report=document.getElementById("reportArea");
  if(!report || !report.innerHTML.trim()){
    alert("پہلے ماہانہ یا سالانہ رپورٹ کھولیں، پھر PDF بٹن دبائیں۔");
    return;
  }

  const school=(db.schoolName||"مدرسہ").replace(/[\\/:*?"<>|]/g,"_");
  const title=document.getElementById("reportHeading")?.textContent||"حاضری رپورٹ";
  const w=window.open("","_blank");
  if(!w){
    alert("PDF/پرنٹ ونڈو نہیں کھل سکی۔ اگر ایپ میں پاپ اپ کی اجازت کا اختیار ہو تو اسے فعال کریں۔");
    return;
  }

  w.document.open();
  w.document.write(`<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${esc(title)}</title>
<style>
body{font-family:Arial,"Noto Nastaliq Urdu",sans-serif;padding:20px;color:#172033}
h2{text-align:center;margin:8px 0}
table{width:100%;border-collapse:collapse;margin-top:20px}
th,td{border:1px solid #999;padding:8px;text-align:center}
th{background:#eee}.present{background:#dcfce7;color:#166534;font-weight:bold}
.absent{background:#fee2e2;color:#991b1b;font-weight:bold}
@page{size:A4;margin:12mm}
@media print{.printBtn{display:none}}
.printBtn{display:block;margin:15px auto;padding:10px 20px;border:0;border-radius:8px;background:#0f766e;color:#fff;font-weight:bold}
</style></head>
<body>
<div id="pdfContent">${report.innerHTML}</div>
<button class="printBtn" onclick="window.print()">📄 PDF / پرنٹ</button>
<script>
window.onload=function(){
  setTimeout(function(){try{window.print()}catch(e){}},500);
};
<\/script>
</body></html>`);
  w.document.close();
}

