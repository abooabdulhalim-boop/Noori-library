const GUJ_URDU=Object.fromEntries(Object.entries(URDU_GUJARATI).map(([u,g])=>[g,u]));
let currentLanguage=localStorage.getItem("madrasa_language")||"ur";
function translatePage(){
 const dict=currentLanguage==="gu"?URDU_GUJARATI:GUJ_URDU;
 document.querySelectorAll("input,textarea").forEach(el=>{if(el.placeholder&&dict[el.placeholder])el.placeholder=dict[el.placeholder]});
 const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);
 nodes.forEach(n=>{const v=n.nodeValue.trim();if(dict[v])n.nodeValue=n.nodeValue.replace(v,dict[v])});
 document.documentElement.lang=currentLanguage==="gu"?"gu":"ur";document.documentElement.dir=currentLanguage==="gu"?"ltr":"rtl";
}
function setLanguage(lang){currentLanguage=lang==="gu"?"gu":"ur";localStorage.setItem("madrasa_language",currentLanguage);translatePage();refresh();translatePage()}
function save(){localStorage.setItem(KEY,JSON.stringify(db));refresh();translatePage()}
function id(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function money(n){return "₹"+Number(n||0).toLocaleString('en-IN')}
function today(){return new Date().toISOString().slice(0,10)}
function showSection(name,btn){document.querySelectorAll('.section').forEach(x=>x.classList.remove('active'));document.getElementById(name).classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');refresh()}

function fillSelects(){
 const ids=["feeStudent"];ids.forEach(id=>{document.getElementById(id).innerHTML='<option value="">منتخب کریں</option>';db.students.forEach(x=>document.getElementById(id).innerHTML+=`<option value="${x.id}">${esc(x.name)}</option>`)});
 salaryTeacher.innerHTML='<option value="">منتخب کریں</option>';db.teachers.forEach(x=>salaryTeacher.innerHTML+=`<option value="${x.id}">${esc(x.name)}</option>`)
}
function studentNameBy(i){return esc((db.students.find(x=>x.id===i)||{}).name||'نام حذف ہوچکا ہے')}
