<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مدرسہ مینجمنٹ سسٹم</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:"Noto Nastaliq Urdu","Jameel Noori Nastaleeq","Noto Naskh Arabic",Tahoma,Arial,sans-serif;background:#f3f6f4;color:#17251d}
header{background:#14532d;color:#fff;padding:18px;text-align:center;position:sticky;top:0;z-index:5}
header h1{margin:0 0 6px;font-size:25px} header p{margin:0;font-size:13px}
nav{display:flex;gap:7px;overflow:auto;background:#fff;padding:8px;position:sticky;top:78px;z-index:4;box-shadow:0 2px 8px #0001}
nav button{white-space:nowrap;border:0;background:#e8f2eb;color:#14532d;padding:10px 13px;border-radius:9px;font-weight:bold;cursor:pointer}
nav button.active{background:#14532d;color:#fff}
main{max-width:1200px;margin:auto;padding:14px}.section{display:none}.section.active{display:block}
.card{background:#fff;border-radius:14px;padding:15px;margin-bottom:14px;box-shadow:0 2px 10px #00000012}
h2{margin-top:0;color:#14532d}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.stat{padding:15px;border-radius:12px;background:#eef7f0;text-align:center}.stat b{display:block;font-size:24px;color:#14532d;margin-top:5px}
input,select,textarea{width:100%;padding:10px;border:1px solid #ccd7cf;border-radius:8px;font-size:15px;background:#fff}
label{font-weight:bold;font-size:13px;display:block;margin:5px 0}.formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px}
.btn{border:0;border-radius:8px;padding:10px 14px;background:#14532d;color:white;font-weight:bold;margin:5px 2px;cursor:pointer}
.btn.secondary{background:#64748b}.btn.danger{background:#b91c1c}.btn.light{background:#e8f2eb;color:#14532d}.btn.warning{background:#b7791f;color:#fff}
table{width:100%;border-collapse:collapse;margin-top:12px;font-size:13px;background:#fff}th,td{border:1px solid #dbe3dd;padding:8px;text-align:right}
th{background:#e8f2eb;color:#14532d}.tablewrap{overflow:auto}.empty{text-align:center;color:#64748b;padding:20px}
.notice{background:#fff7d6;border-right:4px solid #d6a400;padding:10px;border-radius:8px;margin-bottom:10px}.search{margin-top:10px}.small{font-size:12px;color:#64748b}
.reportbox{padding:15px;border:1px dashed #9aa9a0;border-radius:10px;margin-top:10px}.result-good{color:#15803d;font-weight:bold}.result-fail{color:#b91c1c;font-weight:bold}
.urdu-text,h1,h2,h3,p,label,button,th,td,input,select,textarea{font-family:"Noto Nastaliq Urdu","Jameel Noori Nastaleeq","Noto Naskh Arabic",Tahoma,Arial,sans-serif}
h1,h2,h3{line-height:2}button{line-height:1.8}input,select,textarea{line-height:1.8}
@media print{header,nav,.no-print{display:none!important}.section{display:none!important}.section.active{display:block!important}body{background:#fff}.card{box-shadow:none}}

#landingPage{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:linear-gradient(145deg,#0b3d26,#17613b 55%,#d7b56d);text-align:center}
.landing-card{width:min(94%,760px);padding:clamp(28px,7vw,64px) 20px;border:2px solid rgba(255,255,255,.78);border-radius:28px;background:rgba(255,255,255,.10);box-shadow:0 18px 55px #0004;color:#fff}
.landing-mark{font-size:clamp(42px,9vw,76px);margin-bottom:12px}
#launchSystem{display:block;width:100%;border:0;border-radius:20px;padding:22px 12px;background:#fff;color:#14532d;font-size:clamp(30px,7vw,54px);font-weight:900;line-height:1.7;cursor:pointer;box-shadow:0 8px 24px #0003;font-family:inherit}
#launchSystem:active{transform:scale(.985)}
.landing-sub{font-size:clamp(15px,3vw,20px);margin-top:18px;color:#fff}
#appShell{display:none}

</style>
</head>
<body>

<div id="splashScreen" style="display:none;position:fixed;inset:0;z-index:9999;background:#14532d;display:flex;align-items:center;justify-content:center;text-align:center;color:white;font-family:Tahoma,Arial,sans-serif">
<div style="width:min(88%,520px);padding:35px 22px;border:3px solid rgba(255,255,255,.8);border-radius:28px;background:rgba(255,255,255,.08);box-shadow:0 10px 40px rgba(0,0,0,.25)">
<div style="width:105px;height:105px;margin:0 auto 20px;border:3px solid white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;background:#166534">📚</div>
<div style="font-size:34px;font-weight:bold;line-height:1.5">مدرسہ مینجمنٹ سسٹم</div>
<div style="font-size:18px;margin-top:10px;opacity:.95">Madrasa Management System</div>
<div style="margin-top:24px;font-size:13px;opacity:.8">نظام شروع ہو رہا ہے...</div>
</div></div>

<section id="landingPage" aria-label="مرکزی صفحہ">
  <div class="landing-card">
    <div class="landing-mark">📚</div>
    <button id="launchSystem" type="button" onclick="openSystem()">مدرسہ مینیجمنٹ</button>
    <div class="landing-sub">سسٹم کھولنے کے لیے اوپر کلک کریں</div>
    <div style="margin-top:28px;font-size:13px;opacity:.85">MADRASA MANAGEMENT SYSTEM</div>
  </div>
</section>
<div id="appShell">
<header>
<h1 id="appTitle">مدرسہ مینجمنٹ سسٹم</h1>
<p id="madrasaNameDisplay">طلبہ، اساتذہ، فیس، تعاون، تنخواہوں اور مالی حساب کا جامع ریکارڈ</p>
<div style="margin-top:10px">
<button class="btn light" onclick="setLanguage('ur')">اردو</button>
<button class="btn light" onclick="setLanguage('gu')">ગુજરાતી</button>
<button class="btn light" onclick="setMadrasaName()">🏫 مدرسے کا نام</button>
</div>
</header>

<nav>
<button onclick="goBack()">⬅️ بیک</button><button onclick="exitApp()">🚪 ایگزٹ</button>
<button class="active" onclick="showSection('home',this)">🏠 ڈیش بورڈ</button>
<button onclick="showSection('students',this)">👨‍🎓 طلبہ</button>
<button onclick="showSection('teachers',this)">👨‍🏫 اساتذہ</button>
<button onclick="showSection('fees',this)">💰 فیس</button>
<button onclick="showSection('donors',this)">🤝 تعاون</button>
<button onclick="showSection('salaries',this)">💵 تنخواہیں</button>
<button onclick="showSection('finance',this)">📊 آمدنی/اخراجات</button>
<button onclick="showSection('reports',this)">📄 رپورٹس</button>
</nav>

<main>
<section id="home" class="section active">
<div class="card"><h2>مدرسہ مینجمنٹ سسٹم</h2>
<p>مدرسے کے انتظامی، تعلیمی اور مالی امور کو آسان اور منظم انداز میں محفوظ رکھنے کے لیے یہ آف لائن نظام استعمال کریں۔</p>
<div class="notice">تمام ریکارڈ اسی ڈیوائس کے براؤزر میں محفوظ ہوگا۔ باقاعدہ بیک اپ کے لیے ڈیٹا ایکسپورٹ کریں۔</div>
<div class="grid">
<div class="stat">کل طلبہ<b id="sStudents">0</b></div><div class="stat">کل اساتذہ<b id="sTeachers">0</b></div><div class="stat">معاونین<b id="sDonors">0</b></div>
<div class="stat">کل آمدنی<b id="sIncome">₹0</b></div><div class="stat">کل اخراجات<b id="sExpense">₹0</b></div><div class="stat">موجودہ بیلنس<b id="sBalance">₹0</b></div>
</div></div>
<div class="card no-print"><h2>ڈیٹا کی حفاظت</h2>
<button class="btn" onclick="exportData()">💾 ڈیٹا بیک اپ</button>
<button class="btn secondary" onclick="document.getElementById('importFile').click()">📥 بیک اپ بحال کریں</button>
<input id="importFile" type="file" accept=".json" style="display:none" onchange="importData(event)">
<button class="btn danger" onclick="clearAll()">⚠️ تمام ڈیٹا حذف کریں</button>
</div></section>

<section id="students" class="section"><div class="card"><h2>طلبہ کا ریکارڈ</h2><input type="hidden" id="studentId">
<div class="formgrid">
<div><label>طالب علم کا نام</label><input id="studentName"></div><div><label>والد کا نام</label><input id="studentFather"></div>
<div><label>موبائل نمبر</label><input id="studentPhone"></div><div><label>جماعت / درجہ</label><input id="studentClass"></div>
<div><label>پتہ</label><input id="studentAddress"></div><div><label>داخلے کی تاریخ</label><input id="studentDate" type="date"></div>
</div><button class="btn" onclick="saveStudent()">محفوظ کریں</button><button class="btn light" onclick="resetForm('student')">نیا اندراج</button>
<input class="search" id="studentSearch" oninput="renderStudents()" placeholder="نام یا والد کا نام تلاش کریں">
<div class="tablewrap"><table><thead><tr><th>نام</th><th>والد</th><th>موبائل</th><th>جماعت</th><th>تاریخ</th><th>عمل</th></tr></thead><tbody id="studentTable"></tbody></table></div>
</div></section>

<section id="teachers" class="section"><div class="card"><h2>اساتذہ و عملہ</h2><input type="hidden" id="teacherId">
<div class="formgrid"><div><label>نام</label><input id="teacherName"></div><div><label>عہدہ</label><input id="teacherRole"></div><div><label>موبائل</label><input id="teacherPhone"></div><div><label>ماہانہ تنخواہ</label><input id="teacherSalary" type="number"></div></div>
<button class="btn" onclick="saveTeacher()">محفوظ کریں</button><button class="btn light" onclick="resetForm('teacher')">نیا اندراج</button>
<div class="tablewrap"><table><thead><tr><th>نام</th><th>عہدہ</th><th>موبائل</th><th>تنخواہ</th><th>عمل</th></tr></thead><tbody id="teacherTable"></tbody></table></div>
</div></section>

<section id="fees" class="section"><div class="card"><h2>طلبہ کی فیس</h2>
<div class="formgrid"><div><label>تاریخ</label><input id="feeDate" type="date"></div><div><label>طالب علم</label><select id="feeStudent"></select></div><div><label>مہینہ</label><input id="feeMonth" placeholder="مثلاً اگست 2026"></div><div><label>واجب رقم</label><input id="feeDue" type="number"></div><div><label>جمع رقم</label><input id="feePaid" type="number"></div></div>
<button class="btn" onclick="saveFee()">فیس محفوظ کریں</button><button class="btn light" onclick="resetForm('fee')">نیا اندراج</button>
<div class="tablewrap"><table><thead><tr><th>تاریخ</th><th>طالب علم</th><th>مہینہ</th><th>واجب</th><th>جمع</th><th>باقی</th><th>عمل</th></tr></thead><tbody id="feeTable"></tbody></table></div>
</div></section>

<section id="donors" class="section"><div class="card"><h2>مدرسے کے معاونین اور ماہانہ تعاون</h2>
<div class="formgrid"><div><label>معاون کا نام</label><input id="donorName"></div><div><label>موبائل</label><input id="donorPhone"></div><div><label>ماہانہ مقررہ تعاون</label><input id="donorMonthly" type="number"></div><div><label>آج جمع رقم</label><input id="donorPaid" type="number"></div><div><label>مہینہ</label><input id="donorMonth"></div><div><label>تاریخ</label><input id="donorDate" type="date"></div></div>
<button class="btn" onclick="saveDonor()">محفوظ کریں</button><button class="btn light" onclick="resetForm('donor')">نیا اندراج</button>
<div class="tablewrap"><table><thead><tr><th>نام</th><th>موبائل</th><th>ماہانہ</th><th>جمع</th><th>مہینہ</th><th>عمل</th></tr></thead><tbody id="donorTable"></tbody></table></div>
</div></section>

<section id="salaries" class="section"><div class="card"><h2>اساتذہ و ملازمین کی تنخواہیں</h2>
<div class="formgrid"><div><label>استاد/ملازم</label><select id="salaryTeacher"></select></div><div><label>مہینہ</label><input id="salaryMonth"></div><div><label>مقررہ تنخواہ</label><input id="salaryDue" type="number"></div><div><label>ادا شدہ</label><input id="salaryPaid" type="number"></div><div><label>تاریخ</label><input id="salaryDate" type="date"></div></div>
<button class="btn" onclick="saveSalary()">محفوظ کریں</button><button class="btn light" onclick="resetForm('salary')">نیا اندراج</button>
<div class="tablewrap"><table><thead><tr><th>نام</th><th>مہینہ</th><th>مقررہ</th><th>ادا</th><th>باقی</th><th>عمل</th></tr></thead><tbody id="salaryTable"></tbody></table></div>
</div></section>

<section id="finance" class="section"><div class="card"><h2>آمدنی اور اخراجات</h2>
<div class="formgrid"><div><label>تاریخ</label><input id="finDate" type="date"></div><div><label>قسم</label><select id="finType"><option>آمدنی</option><option>اخراجات</option></select></div><div><label>رقم</label><input id="finAmount" type="number"></div><div><label>تفصیل</label><input id="finNote"></div></div>
<button class="btn" onclick="saveFinance()">محفوظ کریں</button><button class="btn light" onclick="resetForm('finance')">نیا اندراج</button>
<div class="tablewrap"><table><thead><tr><th>تاریخ</th><th>قسم</th><th>رقم</th><th>تفصیل</th><th>عمل</th></tr></thead><tbody id="financeTable"></tbody></table></div>
</div></section>

<section id="reports" class="section"><div class="card"><h2>رپورٹس</h2><p>جس رپورٹ کی ضرورت ہو اسے منتخب کریں۔ پرنٹ سے PDF بھی محفوظ کی جا سکتی ہے۔</p>
<div class="grid no-print">
<div><label>رپورٹ کی تاریخ سے</label><input id="reportFrom" type="date"></div><div><label>رپورٹ کی تاریخ تک</label><input id="reportTo" type="date"></div><button class="btn light" onclick="clearReportDates()">تمام تاریخیں</button>
<button class="btn" onclick="report('students')">طلبہ رپورٹ</button><button class="btn" onclick="report('fees')">فیس رپورٹ</button><button class="btn" onclick="report('donors')">تعاون رپورٹ</button><button class="btn" onclick="report('salaries')">تنخواہ رپورٹ</button><button class="btn" onclick="report('finance')">مالی رپورٹ</button>
</div><div id="reportOutput" class="reportbox"></div></div></section>
</main>
</div><!-- appShell -->

<script>
function openSystem(){
  document.getElementById('landingPage').style.display='none';
  document.getElementById('appShell').style.display='block';
  window.scrollTo(0,0);
}
setTimeout(()=>{const s=document.getElementById("splashScreen");if(s){s.style.transition="opacity .5s ease";s.style.opacity="0";setTimeout(()=>s.remove(),550)}},1800);

const KEY="madrasa_management_v2";
let db=JSON.parse(localStorage.getItem(KEY)||'{"students":[],"teachers":[],"attendance":[],"exams":[],"fees":[],"donors":[],"salaries":[],"finance":[]}');
["students","teachers","attendance","exams","fees","donors","salaries","finance"].forEach(k=>{if(!Array.isArray(db[k]))db[k]=[]});

