    <a class="toplink back-to-list" href="#folder-evening">↩ شام کے فولڈر میں واپس</a>
  </section>

  <div class="intro">
    <strong>عملی ترتیب</strong><br>
    رات کو: وضو، آیت الکرسی، تینوں قل، تسبیحاتِ فاطمی اور سونے کی دعائیں۔<br>
    صبح: بیداری کی دعا، مسواک، ہاتھ دھونا اور وضو۔
  </div>
  <div class="footer">✦ اللہ تعالیٰ ہمیں نبی کریم ﷺ کی سنتوں پر عمل کرنے کی توفیق عطا فرمائے۔ آمین ✦<br><a class="toplink" href="#top">↑ واپس فہرست کے آغاز پر</a></div>
</main>

<script>
(() => {
  const themes = {
    emerald: {name:'زمردی محراب',a:'#092e2b',b:'#176b57',gold:'#e8ca7d',ink:'#fff3d4',accent:'#b6d7bd'},
    navy: {name:'نیلاگوں آسمانی',a:'#101b3d',b:'#273f70',gold:'#e6ca91',ink:'#fff8e9',accent:'#b8c9ec'},
    sand: {name:'سنہری صحرا',a:'#604326',b:'#b78a4c',gold:'#fff0bd',ink:'#fff9e9',accent:'#f2d7a4'},
    purple: {name:'جامنی نقش و نگار',a:'#302044',b:'#694a80',gold:'#f0d18b',ink:'#fff4e9',accent:'#d6bce9'},
    black: {name:'سیاہ و سنہری',a:'#111516',b:'#343a36',gold:'#e7c46c',ink:'#fff6dc',accent:'#b8aa82'}
  };
  const esc = v => String(v || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]));
  function lines(text, max) {
    const words = String(text || '').trim().split(/\s+/);
    const out=[]; let line='';
    for (const word of words) {
      const next=line ? line+' '+word : word;
      if (next.length>max && line) { out.push(line); line=word; } else line=next;
    }
    if(line) out.push(line);
    return out;
  }
  function textLines(arr, y, size, color, font, lineHeight, weight='400') {
    return arr.map((line,i)=>`<text x="540" y="${y+i*lineHeight}" text-anchor="middle" direction="rtl" unicode-bidi="plaintext" fill="${color}" font-family="${font}" font-size="${size}" font-weight="${weight}">${esc(line)}</text>`).join('');
  }
  function makeSvg(card, themeKey) {
    const t=themes[themeKey] || themes.emerald;
    const title=card.querySelector('h3')?.innerText.trim() || 'مسنون دعا';
    const arabic=card.querySelector('.arabic')?.innerText.trim() || '';
    const translation=card.querySelector('.translation')?.innerText.trim() || '';
    const ref=card.querySelector('.ref')?.innerText.trim() || '';
    const arLines=lines(arabic, 35);
    const trLines=lines(translation, 47);
    const titleLines=lines(title, 30);
    const h=650 + arLines.length*62 + trLines.length*49 + titleLines.length*48;
    let y=245;
    const titleSvg=textLines(titleLines,y,34,t.gold,"'Noto Nastaliq Urdu',serif",48,'700');
    y += titleLines.length*48+65;
    const arSvg=textLines(arLines,y,36,t.ink,"'Noto Naskh Arabic',serif",62,'500');
    y += arLines.length*62+62;
    const trSvg=textLines(trLines,y,27,t.ink,"'Noto Nastaliq Urdu',serif",49,'400');
    y += trLines.length*49+60;
    const refSvg=textLines(lines(ref,55),y,22,t.gold,"'Noto Nastaliq Urdu',serif",40,'400');
    return `<svg xmlns="http://www.w3.org/2000/svg" width="1080" height="${h}" viewBox="0 0 1080 ${h}">
      <defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${t.a}"/><stop offset="1" stop-color="${t.b}"/></linearGradient>
      <pattern id="pat" width="90" height="90" patternUnits="userSpaceOnUse"><path d="M45 5 L85 45 L45 85 L5 45 Z M45 22 L68 45 L45 68 L22 45 Z" fill="none" stroke="${t.gold}" stroke-opacity=".14" stroke-width="2"/></pattern></defs>
      <rect width="1080" height="${h}" fill="url(#bg)"/><rect width="1080" height="${h}" fill="url(#pat)"/>
      <rect x="28" y="28" width="1024" height="${h-56}" rx="34" fill="none" stroke="${t.gold}" stroke-width="4"/>
      <rect x="45" y="45" width="990" height="${h-90}" rx="25" fill="none" stroke="${t.gold}" stroke-opacity=".45" stroke-width="2"/>
      <g fill="${t.gold}" opacity=".8"><circle cx="540" cy="110" r="9"/><path d="M540 65 Q470 110 540 155 Q610 110 540 65Z" fill="none" stroke="${t.gold}" stroke-width="3"/><path d="M95 190 Q540 95 985 190" fill="none" stroke="${t.gold}" stroke-opacity=".55" stroke-width="2"/></g>
      <text x="540" y="205" text-anchor="middle" fill="${t.accent}" font-family="'Noto Nastaliq Urdu',serif" font-size="27">بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ</text>
      ${titleSvg}${arSvg}${trSvg}${refSvg}
      <path d="M120 ${h-130} Q540 ${h-55} 960 ${h-130}" fill="none" stroke="${t.gold}" stroke-width="2" opacity=".6"/>
      <text x="540" y="${h-78}" text-anchor="middle" fill="${t.gold}" font-family="'Noto Nastaliq Urdu',serif" font-size="26">مسنون اذکار و دعائیں</text>
      <text x="540" y="${h-40}" text-anchor="middle" fill="${t.accent}" font-family="Arial,sans-serif" font-size="17">عبدالسلام نوری  |  M: 9429820648</text>
    </svg>`;
  }
  async function createPng(card, theme) {
    if (document.fonts?.ready) await document.fonts.ready;
    const svg=makeSvg(card,theme);
    const blob=new Blob([svg],{type:'image/svg+xml;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    try {
      const img=new Image();
      await new Promise((resolve,reject)=>{img.onload=resolve;img.onerror=reject;img.src=url;});
      const canvas=document.createElement('canvas');
      canvas.width=1080; canvas.height=img.height;
      const ctx=canvas.getContext('2d');
      ctx.drawImage(img,0,0);
      return await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('تصویر تیار نہیں ہوسکی')),'image/png'));
    } finally { URL.revokeObjectURL(url); }
  }
  function filename(card) {
    const name=(card.querySelector('h3')?.innerText || 'dua').replace(/[\\/:*?"<>|]/g,'').trim().replace(/\s+/g,'-');
    return `dua-${name}.png`;
  }
  document.querySelectorAll('.card').forEach(card=>{
    const tools=document.createElement('div');
    tools.className='image-tools';
    tools.innerHTML=`<label>اسلامی وال پیپر:</label>
      <select aria-label="وال پیپر منتخب کریں">
        <option value="emerald">زمردی محراب</option><option value="navy">نیلا آسمانی</option>
        <option value="sand">سنہری صحرا</option><option value="purple">جامنی نقش و نگار</option>
        <option value="black">سیاہ و سنہری</option>
      </select>
      <button type="button" class="download">تصویر ڈاؤن لوڈ کریں</button>
      <button type="button" class="share">تصویر شیئر کریں</button>
      <div class="hint">منتخب وال پیپر پر دعا کی تصویر بنے گی۔ شیئر کا اختیار آپ کے موبائل/براؤزر کی سہولت کے مطابق کام کرے گا۔</div>`;
    card.appendChild(tools);
    const select=tools.querySelector('select');
    tools.querySelector('.download').addEventListener('click',async()=>{
      const btn=tools.querySelector('.download'); btn.disabled=true; btn.textContent='تصویر تیار ہو رہی ہے…';
      try {
        const png=await createPng(card,select.value);
        const a=document.createElement('a'); const url=URL.createObjectURL(png);
        a.href=url; a.download=filename(card); document.body.appendChild(a); a.click(); a.remove();
        setTimeout(()=>URL.revokeObjectURL(url),1500);
      } catch(e) { alert('تصویر تیار نہ ہوسکی۔ براہِ کرم دوبارہ کوشش کریں۔'); }
      finally {btn.disabled=false;btn.textContent='تصویر ڈاؤن لوڈ کریں';}
    });
    tools.querySelector('.share').addEventListener('click',async()=>{
      const btn=tools.querySelector('.share'); btn.disabled=true; btn.textContent='تصویر تیار ہو رہی ہے…';
      try {
        const png=await createPng(card,select.value);
        const file=new File([png],filename(card),{type:'image/png'});
        if(navigator.canShare && navigator.canShare({files:[file]}) && navigator.share) {
          await navigator.share({files:[file],title:card.querySelector('h3')?.innerText || 'مسنون دعا',text:'مسنون اذکار و دعائیں'});
        } else {
          const a=document.createElement('a'); const url=URL.createObjectURL(png);
          a.href=url; a.download=filename(card); document.body.appendChild(a); a.click(); a.remove();
          setTimeout(()=>URL.revokeObjectURL(url),1500);
          alert('اس براؤزر میں براہِ راست تصویر شیئر دستیاب نہیں؛ تصویر ڈاؤن لوڈ ہوگئی ہے۔ اب اسے گیلری سے شیئر کرسکتے ہیں۔');
        }
      } catch(e) { if(e.name!=='AbortError') alert('شیئر مکمل نہ ہوسکا۔ تصویر ڈاؤن لوڈ کرکے شیئر کریں۔'); }
      finally {btn.disabled=false;btn.textContent='تصویر شیئر کریں';}
    });
  });

  // موجودہ مضمون کو شیئر کرنا
  document.getElementById('share-article')?.addEventListener('click', async () => {
    const article = document.getElementById('article-arab-salafiyyat');
    const articleTitle = article?.querySelector('h3')?.innerText || 'عرب کی سلفیت اور ہندوستان کے اہلِ حدیث';
    const articleText = Array.from(article?.querySelectorAll('p') || []).map(p => p.innerText).join('\n\n');
    const articleUrl = window.location.href.split('#')[0] + '#article-arab-salafiyyat';
    try {
      if (navigator.share) {
        await navigator.share({title: articleTitle, text: articleText + '\n\n✍ ابو اشعر فہیم', url: articleUrl});
      } else {
        window.open('https://wa.me/?text=' + encodeURIComponent(articleTitle + '\n\n' + articleText + '\n\n' + articleUrl), '_blank', 'noopener');
      }
    } catch (e) {
      if (e.name !== 'AbortError') alert('مضمون شیئر نہیں ہوسکا۔ دوبارہ کوشش فرمائیں۔');
    }
  });

  // پوری ویب سائٹ کا لنک سوشل میڈیا پر شیئر کرنا
  const pageTitle = 'مسنون اذکار و دعائیں';
  const pageUrl = window.location.href;
  const shareText = pageTitle + ' — سونے، بیدار ہونے، طہارت اور صبح و شام کے مسنون اذکار';
  document.getElementById('share-site')?.addEventListener('click', async () => {
    try {
      if (navigator.share) {
        await navigator.share({title: pageTitle, text: shareText, url: pageUrl});
      } else {
        const wa = 'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + pageUrl);
        window.open(wa, '_blank', 'noopener');
      }
    } catch (e) {
      if (e.name !== 'AbortError') alert('شیئر نہیں ہوسکا۔ براہِ کرم واٹس ایپ یا لنک کاپی کا بٹن استعمال کریں۔');
    }
  });
  document.getElementById('whatsapp-site')?.addEventListener('click', () => {
    const wa = 'https://wa.me/?text=' + encodeURIComponent(shareText + ' ' + pageUrl);
    window.open(wa, '_blank', 'noopener');
  });
  document.getElementById('copy-site')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      alert('ویب سائٹ کا لنک کاپی ہوگیا ہے۔');
    } catch (e) {
      prompt('اس لنک کو کاپی کریں:', pageUrl);
    }
  });
})();
</script>


<script>
(function(){
  const input = document.getElementById('site-search');
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');
  if (!input || !results || !status) return;

  const entries = [];
  document.querySelectorAll('.card[id]').forEach(card => {
    const title = card.querySelector('h3')?.innerText?.trim() || 'مسنون ذکر';
    const text = card.innerText || '';
    const group = card.previousElementSibling?.classList?.contains('group-title')
      ? card.previousElementSibling.innerText.trim()
      : 'مسنون اذکار و دعائیں';
    entries.push({id: card.id, title, group, text});
  });
  document.querySelectorAll('.article-detail[id]').forEach(article => {
    const title = article.querySelector('h3')?.innerText?.trim() || 'مضمون';
    entries.push({id: article.id, title, group: 'مضامین', text: article.innerText || ''});
  });

  function normalize(s){
    return (s || '').toLocaleLowerCase('ur')
      .replace(/[ًٌٍَُِّْٰـ]/g,'')
      .replace(/[أإآ]/g,'ا')
      .replace(/ي/g,'ی')
      .replace(/ك/g,'ک')
      .replace(/\s+/g,' ')
      .trim();
  }
  input.addEventListener('input', function(){
    const q = normalize(input.value);
    results.replaceChildren();
    if (!q) {
      results.hidden = true;
      status.textContent = 'تمام موضوعات میں تلاش کریں';
      return;
    }
    const matches = entries.filter(item =>
      normalize(item.title + ' ' + item.group + ' ' + item.text).includes(q)
    ).slice(0, 30);

    results.hidden = false;
    status.textContent = matches.length
      ? `تلاش کے نتائج: ${matches.length}${matches.length === 30 ? ' (پہلے 30 نتائج)' : ''}`
      : 'معذرت! اس لفظ سے متعلق کوئی مواد نہیں ملا۔';

    if (!matches.length) {
      const empty = document.createElement('div');
      empty.className = 'search-empty';
      empty.textContent = 'کوئی نتیجہ نہیں ملا۔ دوسرا لفظ لکھ کر تلاش کریں۔';
      results.appendChild(empty);
      return;
    }
    matches.forEach(item => {
      const a = document.createElement('a');
      a.className = 'search-result';
      a.href = '#' + item.id;
      const strong = document.createElement('strong');
      strong.textContent = item.title;
      const small = document.createElement('small');
      small.textContent = item.group;
      a.append(strong, small);
      a.addEventListener('click', () => {
        results.hidden = true;
        input.value = '';
        status.textContent = 'مطلوبہ مواد کھولا جا رہا ہے';
      });
      results.appendChild(a);
    });
  });
})();
</script>

