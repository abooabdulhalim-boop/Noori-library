 if(type==='donor'){donorName.value='';donorPhone.value='';donorMonthly.value='';donorPaid.value='';donorMonth.value='';donorDate.value=today()}
 if(type==='salary'){salaryTeacher.value='';salaryMonth.value='';salaryDue.value='';salaryPaid.value='';salaryDate.value=today()}
 if(type==='finance'){finAmount.value='';finNote.value='';finDate.value=today()}
}

