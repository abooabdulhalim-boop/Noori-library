function saveStudent(){const o={id:studentId.value||id(),name:studentName.value,father:studentFather.value,phone:studentPhone.value,cls:studentClass.value,address:studentAddress.value,date:studentDate.value};if(!o.name.trim())return alert('طالب علم کا نام لکھیں');const i=db.students.findIndex(x=>x.id===o.id);if(i>=0)db.students[i]=o;else db.students.push(o);save();resetForm('student')}
function renderStudents(){const q=(studentSearch.value||'').toLowerCase();studentTable.innerHTML=db.students.filter(x=>(x.name+x.father).toLowerCase().includes(q)).map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.father)}</td><td>${esc(x.phone)}</td><td>${esc(x.cls)}</td><td>${esc(x.date)}</td><td><button class="btn warning" onclick="editStudent('${x.id}')">ترمیم</button><button class="btn danger" onclick="del('students','${x.id}')">حذف</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">کوئی ریکارڈ نہیں</td></tr>'}
function editStudent(k){const x=db.students.find(x=>x.id===k);if(!x)return;studentId.value=x.id;studentName.value=x.name;studentFather.value=x.father;studentPhone.value=x.phone;studentClass.value=x.cls;studentAddress.value=x.address;studentDate.value=x.date;showSection('students',document.querySelector('nav button:nth-child(2)'))}

