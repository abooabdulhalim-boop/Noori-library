      <strong id="targetText"></strong>
    </div>

    <div>
      آج کی انگریزی تاریخ:
      <strong id="todayText"></strong>
    </div>

  </div>

  <p class="note">
    یہ گنتی پہلے روزے کی متوقع تاریخ کے مطابق ہے۔
    حتمی تاریخ چاند کی رؤیت اور مقامی اعلان کے مطابق
    ایک دن آگے پیچھے ہو سکتی ہے۔
  </p>

  <div class="settings">

    <details>

      <summary>⚙ تاریخ تبدیل کریں</summary>

      <label for="targetDate">
        پہلے روزے کی تاریخ منتخب کریں
      </label>

      <input type="date" id="targetDate"
             value="2027-02-09">

      <button id="saveDate">
        تاریخ محفوظ کریں
      </button>

    </details>

  </div>

</main>

<script>
(() => {

  const defaultDate = "2027-02-09";
  const dateInput = document.getElementById("targetDate");

  let target = defaultDate;

  try {
    target = localStorage.getItem("ramadanTargetDate")
      || defaultDate;
  } catch(e) {}

  dateInput.value = target;

  const urduDigits = n =>
    String(n).replace(/\d/g, d => "۰۱۲۳۴۵۶۷۸۹"[Number(d)]);

  const months = [
    "جنوری","فروری","مارچ","اپریل","مئی","جون",
    "جولائی","اگست","ستمبر","اکتوبر","نومبر","دسمبر"
  ];

  const weekdays = [
    "اتوار","پیر","منگل","بدھ",
    "جمعرات","جمعہ","ہفتہ"
  ];

  const hijriMonths = [
    "محرم","صفر","ربیع الاول","ربیع الآخر",
    "جمادی الاول","جمادی الآخر","رجب","شعبان",
    "رمضان","شوال","ذوالقعدہ","ذوالحجہ"
  ];

  function formatHijriDate(d) {
    try {
      const parts = new Intl.DateTimeFormat(
        "en-u-ca-islamic-umalqura",
        {
          day:"numeric",
          month:"numeric",
          year:"numeric"
        }
      ).formatToParts(d);

      const get = type =>
        Number(parts.find(p => p.type === type)?.value);

      const day = get("day");
      const month = get("month");
      const year = get("year");

      if (!day || !month || !year ||
          !hijriMonths[month - 1]) {
        throw new Error("Date unavailable");
      }

      return "آج کی ہجری تاریخ: " +
        urduDigits(day) + " " +
        hijriMonths[month - 1] + " " +
        urduDigits(year) + "ھ";

    } catch(e) {
      return "ہجری تاریخ اس براؤزر میں دستیاب نہیں";
    }
  }

  function formatDate(d) {
    return `${urduDigits(d.getDate())} ${
      months[d.getMonth()]
    } ${urduDigits(d.getFullYear())}ء، بروز ${
      weekdays[d.getDay()]
    }`;
  }

  function update() {

    const now = new Date();

    const parts = target.split("-").map(Number);

    const goal = new Date(
      parts[0],parts[1]-1,parts[2],0,0,0
    );

    document.getElementById("hijriDate").textContent =
      formatHijriDate(now);

    document.getElementById("todayText").textContent =
      formatDate(now);

    document.getElementById("targetText").textContent =
      formatDate(goal);

    let diff = goal.getTime() - now.getTime();

    if (diff <= 0) {

      document.getElementById("days").textContent = "مبارک";

      document.getElementById("daysLabel").textContent =
        "رمضان المبارک شروع ہو چکا ہے";

      ["hours","minutes","seconds"].forEach(id => {
        document.getElementById(id).textContent = "۰۰";
      });

      return;
    }

    const totalSeconds = Math.floor(diff / 1000);

    const days = Math.floor(totalSeconds / 86400);

    const hours = Math.floor(
      (totalSeconds % 86400) / 3600
    );

    const minutes = Math.floor(
      (totalSeconds % 3600) / 60
    );

    const seconds = totalSeconds % 60;

    document.getElementById("days").textContent =
      urduDigits(days);

    document.getElementById("daysLabel").textContent =
      "دن باقی ہیں";

    document.getElementById("hours").textContent =
      urduDigits(String(hours).padStart(2,"0"));

    document.getElementById("minutes").textContent =
      urduDigits(String(minutes).padStart(2,"0"));

    document.getElementById("seconds").textContent =
      urduDigits(String(seconds).padStart(2,"0"));
  }

  document.getElementById("saveDate")
    .addEventListener("click", () => {

      if (!dateInput.value) return;

      target = dateInput.value;

      try {
        localStorage.setItem("ramadanTargetDate",target);
      } catch(e) {}

      update();
    });

  update();

  setInterval(update,1000);

})();
</script>

</body>
