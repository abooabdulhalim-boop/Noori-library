 if(type==='student'){document.querySelectorAll('#students input').forEach(x=>{if(x.type!=='hidden')x.value=''});studentId.value=''}
 if(type==='teacher'){document.querySelectorAll('#teachers input').forEach(x=>{if(x.type!=='hidden')x.value=''});teacherId.value=''}
